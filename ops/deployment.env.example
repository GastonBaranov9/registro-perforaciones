# Copiar fuera del repositorio como deployment.env y reemplazar por refs inmutables.
# No agregar secretos: este archivo se combina despues del env privado de produccion.
DEPLOYMENT_STATE_FORMAT=1
API_IMAGE_REF=registry.example/registro-perforaciones-api:git-sha
FRONT_IMAGE_REF=registry.example/registro-perforaciones-front:git-sha
APP_VERSION=version-inmutable
GIT_SHA=git-sha
# Recalcular con ops/deployment-state.ps1 o ops/deployment-state.sh.
DEPLOY_CONFIG_SHA256=reemplazar-con-sha256-canonico
