map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# JSON sin query string ni headers sensibles; $request_id se propaga a Fastify.
log_format rsp_json escape=json '{"timestamp":"$time_iso8601","request_id":"$request_id","method":"$request_method","path":"$uri","status":$status,"duration":$request_time,"upstream":"$upstream_addr"}';
access_log /var/log/nginx/access.log rsp_json;

server {
    listen 80;
    server_name ${PUBLIC_HOST};
    return 308 ${PUBLIC_ORIGIN}$request_uri;
}

server {
    listen 443 ssl;
    server_name ${PUBLIC_HOST};

    if ($host != "${PUBLIC_HOST}") { return 421; }

    ssl_certificate     /etc/nginx/tls/tls.crt;
    ssl_certificate_key /etc/nginx/tls/tls.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_timeout 1d;
    ssl_session_cache shared:RSP_TLS:10m;
    ssl_session_tickets off;

    # Contrato RSP-07B: binario 5.000.000, JSON 6.922.668, proxy 7 MiB.
    client_max_body_size 7m;
    client_body_timeout 30s;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "same-origin" always;
    add_header X-Frame-Options "DENY" always;
    add_header Permissions-Policy "geolocation=(self), camera=(), microphone=(), payment=(), usb=(), fullscreen=(self)" always;
    # Ionic necesita estilos inline; scripts, conexiones e imÃ¡genes permanecen same-origin.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
    # Vacío durante pruebas locales. En TLS público estable: max-age=31536000.
    add_header Strict-Transport-Security "${HSTS_HEADER}" always;

    location = /api {
        return 308 /api/;
    }

    location /api/ {
        proxy_pass http://api:3000/;
        proxy_http_version 1.1;
        proxy_connect_timeout 5s;
        proxy_send_timeout 30s;
        proxy_read_timeout 90s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Request-Id $request_id;
    }

    location = /ws {
        proxy_pass http://api:3000/ws;
        proxy_http_version 1.1;
        proxy_connect_timeout 5s;
        proxy_send_timeout 30s;
        proxy_read_timeout 300s;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Request-Id $request_id;
    }

    location / {
        proxy_pass http://front:80;
        proxy_http_version 1.1;
        proxy_connect_timeout 5s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Request-Id $request_id;
    }
}
