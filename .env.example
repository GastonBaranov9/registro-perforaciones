# PostgreSQL development. Production Compose always uses postgres:5432 internally.
PGUSER=replace_with_database_user
PGPASSWORD=
PGHOST=127.0.0.1
PGPORT=5433
PGDATABASE=registro_perforaciones

# API. FASTIFY_SECRET must be random, at least 32 characters, and different per environment.
NODE_ENV=development
API_PORT=3000
FASTIFY_SECRET=
# Empty means same-origin only in production. Separate multiple exact origins with commas.
CORS_ORIGINS=

# Photos. Empty uses api/public only in development.
# Production Compose sets the canonical container path and mounts a dedicated volume.
FOTOS_DIR=
# Functional limits are code-owned: binary 5,000,000 bytes; proxy 7 MiB.
# Cookies remain host-only, Path=/, SameSite=Lax; Secure is derived from NODE_ENV=production.

# Google Maps Static: backend-only. Use separate restricted keys for DEV and PROD.
MAP_STATIC_URL_TEMPLATE=https://maps.googleapis.com/maps/api/staticmap?center={latitud},{longitud}&zoom=17&size=640x400&scale=2&maptype=satellite&markers=color:red%7C{latitud},{longitud}&key={apiKey}
MAP_STATIC_ALLOWED_HOST=maps.googleapis.com
MAP_STATIC_API_KEY=
MAP_STATIC_ATTRIBUTION=Google Maps

# Compatibility fallback outside production Compose; canonical MAP_STATIC_* takes priority.
PDF_MAP_STATIC_URL_TEMPLATE=
PDF_MAP_ALLOWED_HOST=
PDF_MAP_STATIC_API_KEY=
PDF_MAP_ATTRIBUTION=

# Reproducible images. Use an immutable Git-SHA tag or a registry digest.
API_IMAGE_REF=registro-perforaciones-api:replace_with_git_commit
FRONT_IMAGE_REF=registro-perforaciones-front:replace_with_git_commit
HTTP_BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080

# Legacy delivery scripts only; not application runtime.
DOCKER_REGISTRY=
DOCKER_USER=
DOCKER_PASS=
REMOTE_HOST=
REMOTE_USER=
