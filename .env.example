PGUSER=postgres
PGPASSWORD=change_me
PGHOST=localhost
PGPORT=5432
PGDATABASE=registro_perforaciones
FASTIFY_SECRET=change_this_with_a_long_random_secret
# Imagen estática aérea/satelital opcional, compartida por frontend y PDF mediante la API.
# La plantilla debe ser HTTPS, incluir marcador/zoom/estilo en el proveedor y admitir
# {lat}/{lon} y, si aplica, {key}; también admite los aliases heredados
# {latitud}/{longitud}/{apiKey}. No exponga la clave en el frontend.
MAP_STATIC_URL_TEMPLATE=
MAP_STATIC_ALLOWED_HOST=
MAP_STATIC_API_KEY=
MAP_STATIC_ATTRIBUTION=
# Compatibilidad temporal: se conservan PDF_MAP_STATIC_URL_TEMPLATE, PDF_MAP_ALLOWED_HOST,
# PDF_MAP_STATIC_API_KEY y PDF_MAP_ATTRIBUTION como fallback cuando el MAP_STATIC_* equivalente
# está vacío o ausente. Si ambos tienen valor, MAP_STATIC_* tiene prioridad.
PDF_MAP_STATIC_URL_TEMPLATE=
PDF_MAP_ALLOWED_HOST=
PDF_MAP_STATIC_API_KEY=
PDF_MAP_ATTRIBUTION=
