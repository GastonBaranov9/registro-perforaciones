PGUSER=postgres
PGPASSWORD=change_me
PGHOST=localhost
PGPORT=5432
PGDATABASE=registro_perforaciones
FASTIFY_SECRET=change_this_with_a_long_random_secret
# Mapa estático opcional para PDF. Sin estas cuatro variables se usa el fallback local.
# La plantilla debe ser HTTPS y admitir {latitud}, {longitud} y, si aplica, {apiKey}.
PDF_MAP_STATIC_URL_TEMPLATE=
PDF_MAP_ALLOWED_HOST=
PDF_MAP_STATIC_API_KEY=
PDF_MAP_ATTRIBUTION=
