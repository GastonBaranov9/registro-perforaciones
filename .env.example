PGUSER=postgres
PGPASSWORD=change_me
PGHOST=localhost
PGPORT=5432
PGDATABASE=registro_perforaciones
FASTIFY_SECRET=change_this_with_a_long_random_secret
# Google Maps Static API, compartida por frontend y PDF exclusivamente mediante la API.
# La clave queda solo en el backend. Use claves diferentes y restringidas en DEV y PROD.
MAP_STATIC_URL_TEMPLATE=https://maps.googleapis.com/maps/api/staticmap?center={latitud},{longitud}&zoom=17&size=640x400&scale=2&maptype=satellite&markers=color:red%7C{latitud},{longitud}&key={apiKey}
MAP_STATIC_ALLOWED_HOST=maps.googleapis.com
MAP_STATIC_API_KEY=
MAP_STATIC_ATTRIBUTION=Google Maps
# Compatibilidad temporal: se conservan PDF_MAP_STATIC_URL_TEMPLATE, PDF_MAP_ALLOWED_HOST,
# PDF_MAP_STATIC_API_KEY y PDF_MAP_ATTRIBUTION como fallback cuando el MAP_STATIC_* equivalente
# está vacío o ausente. Si ambos tienen valor, MAP_STATIC_* tiene prioridad.
PDF_MAP_STATIC_URL_TEMPLATE=
PDF_MAP_ALLOWED_HOST=
PDF_MAP_STATIC_API_KEY=
PDF_MAP_ATTRIBUTION=
